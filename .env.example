# ============================================================
#  طريق — متغيرات البيئة
#  انسخ هاد الملف لـ.env.local وعمّرو. .env.local ماشي مُتتبَّع فـgit.
# ============================================================

# قاعدة البيانات (Neon ولا أي Postgres 16+)
# Neon: خذ «Pooled connection» من لوحة التحكم
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ⚠️ النشر على Vercel: زيد DATABASE_URL فـ
#    Project → Settings → Environment Variables (Production + Preview).
#    بلاه الموقع كيتبنى وكيخدم، ولكن الدخول والدردشة كيرجعو 503
#    برسالة واضحة. الصفحات العامة (التصفح، البحث) ماكتتأثرش.

# اتصال مباشر بلا pooler — كيلزم غير لبعض أدوات الهجرة
# DATABASE_URL_UNPOOLED="postgresql://user:password@host-direct/dbname?sslmode=require"

# اختياري: أقصى عدد اتصالات فالـpool (افتراضي 10)
# PGPOOL_MAX=10

# ============================================================
#  إرسال الإيميل — رموز الدخول
# ============================================================
# فالتطوير المحلي: الرمز كيبان فالسجل وفالواجهة، ماشي محتاج مزوّد.
#
# ⚠ فالإنتاج: بلا هاد المتغيّرات ماكاينش دخول أصلاً — المسار كيرجع
#   خطأ واضح. عمرو ما كيرجع الرمز للمتصفح، حيت هادشي معناه أي واحد
#   كيدخل بأي إيميل.
#
# ثلاثة خيارات — اختار واحد:

# --- 1. Brevo (منصوح بيه) — 300 إيميل فاليوم مجاناً ---
# brevo.com → SMTP & API → API Keys
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY="xkeysib-xxx"

# --- 2. Resend — 3000 إيميل فالشهر مجاناً ---
# resend.com → API Keys
# EMAIL_PROVIDER=resend
# RESEND_API_KEY="re_xxx"

# --- 3. SMTP عام (Gmail، Brevo SMTP، أي خادم) ---
# Gmail: خاصك «كلمة سر التطبيقات» ماشي كلمة السر العادية —
#   myaccount.google.com → Security → 2-Step Verification → App passwords
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp-relay.brevo.com     # ولا smtp.gmail.com
# SMTP_PORT=587                       # 465 = TLS مباشر، 587 = STARTTLS
# SMTP_USER="..."
# SMTP_PASS="..."

# المُرسِل — خاصو يكون نطاق موثّق عند المزوّد.
# EMAIL_FROM="طريق <contact@mbndev.ma>"

# ============================================================
#  صور الإعلانات — Vercel Blob
# ============================================================
# Vercel → Storage → Blob → أنشئ خزّان، ونسخ التوكن.
# ملي ماكيكونش مضبوط: معالج البيع كيبيّن رسالة وكيخلّيك تكمّل
# الإعلان بلا صور، والموقع كيرسم المركبة كما كان.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# اختياري — معرّف الخزّان، مفيد غير للأدوات
# BLOB_STORE_ID="store_xxx"

# ---------- لوحة الإشراف /admin ----------
# دخول مستقل تماماً على حسابات الموقع: كلمة سر + رمز للإيميل.
# بلا هاد الجوج الصفحة كترجع 404 لأي واحد.

# الإيميلات المسموحة، مفرّقة بفاصلة
# ADMIN_EMAILS="ana@example.ma,shi-wahed-akhor@example.ma"

# كلمة السر — الـhash، ماشي الكلمة. باش تولّدو:
#   node -e "const{scryptSync,randomBytes}=require('node:crypto');const s=randomBytes(16);console.log('scrypt\$'+s.toString('hex')+'\$'+scryptSync(process.argv[1],s,64).toString('hex'))" 'كلمة-السر-ديالك'
# ADMIN_PASSWORD_HASH="scrypt$...$..."

# سرّ المهام اليومية (انتهاء الترويجات).
# Vercel Cron كيصيفطو فرأس authorization. بلاه المسار محلول للكل.
# CRON_SECRET="شي-كلمة-طويلة-وعشوائية"

# العنوان اللي كتوصل ليه رسائل نموذج الاتصال.
# بلاه كنستعملو EMAIL_FROM.
# CONTACT_EMAIL="contact@example.ma"

# نطاق الموقع للروابط فالإيميل — الرسائل ماكيقدروش يستعملو روابط
# نسبية. بلاه كنستعملو https://triq.ma.
# حطّو غير إلا كنجرّبو على نطاق مؤقت ديال Vercel.
# NEXT_PUBLIC_SITE_URL="https://triq.ma"
