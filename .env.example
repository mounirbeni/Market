# ============================================================
#  طريق — متغيرات البيئة
#  انسخ هاد الملف لـ.env.local وعمّرو. .env.local ماشي مُتتبَّع فـgit.
# ============================================================

# قاعدة البيانات (Neon ولا أي Postgres 16+)
# Neon: خذ «Pooled connection» من لوحة التحكم
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# اتصال مباشر بلا pooler — كيلزم غير لبعض أدوات الهجرة
# DATABASE_URL_UNPOOLED="postgresql://user:password@host-direct/dbname?sslmode=require"

# اختياري: أقصى عدد اتصالات فالـpool (افتراضي 10)
# PGPOOL_MAX=10

# مزوّد SMS لرموز التحقق (OTP).
# ملي ماكيكونش مضبوط: الرمز كيتطبع فالسجل وكيرجع للواجهة فالتطوير فقط.
# ملي كيتضبط: الرمز كيتصيفط بـSMS وماكيرجعش أبداً للمتصفح.
# SMS_PROVIDER=twilio
